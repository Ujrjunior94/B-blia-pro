<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <rect width="512" height="512" rx="112" fill="#151311"/>
  <rect x="24" y="24" width="464" height="464" rx="90" fill="none" stroke="#3E5641" stroke-width="8"/>
  <circle cx="256" cy="256" r="190" fill="#3E5641" opacity="0.15"/>
  <!-- Golden Open Bible Icon -->
  <g transform="translate(106, 126)">
    <path d="M 150 20 C 110 5, 50 15, 10 30 L 10 210 C 50 195, 110 185, 150 200 Z" fill="#F7F1E5" stroke="#D4A24C" stroke-width="8"/>
    <path d="M 150 20 C 190 5, 250 15, 290 30 L 290 210 C 250 195, 190 185, 150 200 Z" fill="#FFFDF8" stroke="#D4A24C" stroke-width="8"/>
    <line x1="150" y1="20" x2="150" y2="200" stroke="#D4A24C" stroke-width="10"/>
    <!-- Cross on Right Page -->
    <path d="M 220 70 L 220 150 M 190 95 L 250 95" stroke="#D4A24C" stroke-width="8" stroke-linecap="round"/>
    <!-- Text Lines on Left Page -->
    <line x1="35" y1="70" x2="125" y2="60" stroke="#3E5641" stroke-width="6" stroke-linecap="round"/>
    <line x1="35" y1="100" x2="125" y2="90" stroke="#3E5641" stroke-width="6" stroke-linecap="round"/>
